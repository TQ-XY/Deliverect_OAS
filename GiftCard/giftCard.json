  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Machine 2 Machine Access Token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "examples": [
                  {
                    "client_id": "{{clientId}}",
                    "client_secret": "{{clientSecret}}",
                    "audience": "https://api.satging.deliverect.com",
                    "grant_type": "token"
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "accept",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "application/json"
          },
          {
            "name": "content-type",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "application/json"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Accept": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "application/json"
                  ]
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "application/json"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "Date": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "Wed, 20 Feb 2019 13:11:39 GMT"
                  ]
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "application/json"
                  ]
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "examples": [
                    "60"
                  ]
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "keep-alive"
                  ]
                }
              },
              "X-Auth0-RequestId": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "1bb8a6bbea0c249b00dd"
                  ]
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "examples": [
                    "30"
                  ]
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "examples": [
                    "29"
                  ]
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer",
                  "examples": [
                    "1550668300"
                  ]
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "Basic realm={{Users}}"
                  ]
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "private, no-store, no-cache, must-revalidate, post-check=0, pre-check=0"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "error": "access_denied",
                  "error_description": "Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/giftCards/channel/{channelLinkId}/providerProfileLinks": {
      "get": {
        "summary": "Get profile links",
        "parameters": [
          {
            "name": "channelLinkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{channelLinkId}}"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "giftCardProviderProfileLinks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "response": {
                    "value": {
                      "giftCardProviderProfileLinks": [
                        {
                          "id": "{{giftCardProviderProfileLinkId}}",
                          "name": "string"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Deliverect Endpoints"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "operationId": "get_giftcards-channel-channellinkid-providerprofilelinks"
      }
    },
    "/giftCards/channel/{channelLinkId}/profileLink/{giftCardProviderProfileLinkId}/applyGiftCard": {
      "post": {
        "summary": "Apply gift card",
        "parameters": [
          {
            "name": "channelLinkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{channelLinkId}}"
          },
          {
            "name": "giftCardProviderProfileLinkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{giftCardProviderProfileLinkId}}"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "balance": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Deliverect Endpoints"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string",
                    "format": "color"
                  },
                  "verificationCode": {
                    "type": "string",
                    "format": "utc-millisec"
                  },
                  "amount": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "number": "ABC",
                "verificationCode": "1234",
                "amount": 100
              }
            }
          }
        },
        "operationId": "post_giftcards-channel-channellinkid-profilelink-giftcardproviderprofilelinkid-applygiftcard"
      }
    },
    "/giftCards/channel/{channelLinkId}/profileLink/{giftCardProviderProfileLinkId}/getGiftCardBalance": {
      "post": {
        "summary": "Get balance",
        "parameters": [
          {
            "name": "channelLinkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{channelLinkId}}"
