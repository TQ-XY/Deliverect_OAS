        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "balance": {
                      "type": "integer"
                    }
                  }
                },
                "examples": {
                  "exampleFromExisting200": {
                    "value": {
                      "amount": 6346,
                      "giftCardNumber": "6000101001050148"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Deliverect Endpoints"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string",
                    "format": "color"
                  },
                  "verificationCode": {
                    "type": "string",
                    "format": "utc-millisec"
                  }
                }
              },
              "example": {
                "number": "ABC",
                "verificationCode": "1234"
              }
            }
          }
        },
        "operationId": "post_giftcards-channel-channellinkid-profilelink-giftcardproviderprofilelinkid-getgiftcardbalance"
      }
    }
